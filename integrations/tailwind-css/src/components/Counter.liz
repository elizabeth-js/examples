import { clientState } from "elizabeth/client";

@client
@public
<Counter>
  const [count, setCount] = clientState(0);

  <div className="flex items-center gap-3">
    <button
      className="rounded-md bg-cyan-400 px-3 py-2 text-sm font-black text-slate-950 shadow-sm shadow-cyan-950/30 transition hover:bg-cyan-300"
      onClick={() => setCount(count + 1)}
    >
      Add
    </button>
    <button
      className="rounded-md border border-slate-700 px-3 py-2 text-sm font-black text-slate-200 transition hover:border-slate-500 hover:bg-slate-900"
      onClick={() => setCount(0)}
    >
      Reset
    </button>
    <span className="rounded-md bg-slate-900 px-3 py-2 text-sm font-black text-cyan-200 ring-1 ring-slate-800">
      {count}
    </span>
  </div>
</Counter>

